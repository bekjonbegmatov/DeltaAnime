# Docker Compose: http://localhost:8080
APP_PORT=8080
BIND_HOST=127.0.0.1
# Keep loopback hosts for the healthcheck; append your domain without https:// or a port.
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional provider settings. Never commit real credentials.
KODIK_TOKEN=
KODIK_AUTO_TOKEN=1
ALLOHA_TOKEN=
ANIMEGO_MIRROR=animego.me
ANIME_PROXY=

# Development only: exact Vite tunnel hosts, comma-separated, no scheme or port.
# Prefer putting this in the ignored root .env.local.
VITE_ALLOWED_HOSTS=
